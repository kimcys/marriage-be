# Env file for docker-compose.production.yml -- a multi-Droplet deployment
# where `api`, `worker` (one or more), and `beat` (exactly one, total) run
# on separate DigitalOcean Droplets, sharing a Managed Postgres database, a
# Managed Redis instance (standing in for Valkey's broker role), and a
# Spaces bucket instead of anything local to one Droplet.
#
# Usage on each Droplet:
#   docker compose -f docker-compose.production.yml --env-file .env.production pull
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d api      # on the API Droplet
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d worker   # on each worker Droplet
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d beat     # on exactly one Droplet
#
# This file documents every variable docker-compose.production.yml requires;
# see .env.example instead for the single-Droplet/local docker-compose.yml.

# --- Image ---------------------------------------------------------------
# Where the built image lives. Build and tag it once (CI, or manually from
# this repo: `docker build -t $IMAGE_NAME:$IMAGE_TAG .`), push it to a
# registry such as DigitalOcean Container Registry, then every Droplet just
# pulls this same tag rather than rebuilding (rebuilding on every Droplet
# also re-downloads Playwright's ~260MB Chromium binary every time).
IMAGE_NAME=registry.digitalocean.com/your-registry/marriage-be
IMAGE_TAG=latest

# --- Managed Database for PostgreSQL --------------------------------------
# From the DigitalOcean console: Databases -> your cluster -> Connection
# Details -> "Connection string", with the scheme changed from postgresql://
# to postgresql+psycopg:// (this repo's driver). Keep sslmode=require.
DATABASE_URL=postgresql+psycopg://doadmin:REPLACE_ME@REPLACE_ME.db.ondigitalocean.com:25060/marriage_ocr?sslmode=require

# --- Managed Redis (Valkey's role) ----------------------------------------
# Two options:
#
# 1. DigitalOcean Managed Redis -- console: Databases -> your Redis cluster
#    -> Connection Details. Use rediss:// (TLS, required), and append
#    ?ssl_cert_reqs=CERT_NONE (Celery's redis backend refuses to start
#    against a rediss:// URL without this parameter explicitly set):
#      VALKEY_URL=rediss://default:REPLACE_ME@REPLACE_ME.db.ondigitalocean.com:25061/0?ssl_cert_reqs=CERT_NONE
#
# 2. Self-hosted on this same Droplet (combined single-Droplet setup) --
#    `docker run -d --name valkey --restart unless-stopped -p 127.0.0.1:6379:6379 valkey/valkey:8`.
#    Use host.docker.internal, NOT 127.0.0.1/localhost -- api/worker/beat
#    run in their own container network namespace, so their own
#    127.0.0.1 is themselves, not the Droplet. host.docker.internal
#    resolves to the Droplet's real network (works via this repo's
#    docker-compose.production.yml `extra_hosts` entry, which Linux
#    Docker Engine needs explicitly -- Docker Desktop provides it for
#    free, plain Linux does not):
VALKEY_URL=redis://host.docker.internal:6379/0

# --- Spaces (S3-compatible object storage) --------------------------------
# Create a Space + an access key pair under API -> Spaces Keys in the
# DigitalOcean console. The endpoint is https://<region>.digitaloceanspaces.com
# (region-only, NOT the per-bucket subdomain form).
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET_NAME=marriage-be
SPACES_REGION_NAME=nyc3
SPACES_ACCESS_KEY_ID=REPLACE_ME
SPACES_SECRET_ACCESS_KEY=REPLACE_ME

# --- Google Vision / Gemini ------------------------------------------------
# Path to the service-account JSON file ON THIS DROPLET (every Droplet
# running api/worker/beat needs its own copy at whatever path you put here --
# it's bind-mounted into the container, never baked into the image).
GOOGLE_APPLICATION_CREDENTIALS=/root/secrets/google-vision.json
GEMINI_API_KEY=REPLACE_ME

# --- Auth (JWT) --------------------------------------------------------
# Every JWT issued by POST /api/v1/auth/login is signed with this -- anyone
# who has it can forge a valid admin token, so it must be a real random
# secret here, NOT the insecure "change-me-in-production..." default the
# app falls back to if this is left unset. Generate one with:
#   openssl rand -base64 48
# Same value on every Droplet (api/worker/beat all need it, since worker/
# beat load Settings too even though they don't check tokens themselves).
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
# 7 days -- there's no refresh-token flow, so this is how long someone
# stays logged in before having to sign back in.
JWT_EXPIRES_MINUTES=10080

# --- API-only (harmless to set on worker/beat Droplets too; unused there) -
CORS_ORIGINS=https://your-frontend.example.com
MAX_UPLOAD_BYTES=104857600
UPLOAD_CHUNK_BYTES=1048576

# --- Tuning ----------------------------------------------------------------
# Per-worker-container Celery concurrency. Jobs are mostly I/O-bound
# (Vision/Gemini API calls), so this can reasonably exceed the Droplet's
# core count -- the real ceiling is RAM per subprocess and your Vision/
# Gemini API rate limits. Scale throughput further by running the `worker`
# service on more Droplets, or with `docker compose ... up -d --scale worker=N`
# on one -- Celery load-balances across however many worker processes exist
# on the shared queue, no code changes needed either way.
OCR_MAX_CONCURRENT_JOBS=4
OCR_TIMEOUT_SECONDS=3600
# Separate, much larger budget for a whole OneDrive-link submission (fetch +
# classify + ingest every file it resolves to), not just one OCR run -- see
# onedrive/tasks.py. Default is already generous (6 hours); only raise it if
# your links routinely contain several thousand files.
ONEDRIVE_FETCH_TIMEOUT_SECONDS=21600

# --- Rarely need to change -------------------------------------------------
MARRIAGE_OCR_GIT_URL=https://github.com/kimcys/marriage-ocr.git
MARRIAGE_OCR_GIT_REF=d0a0a0bb450404c4539bd0eb75ef882d6b1e53ed
APP_LOG_LEVEL=INFO
OCR_STDERR_API_LIMIT=1000
