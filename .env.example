APP_NAME=Marriage OCR API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4200
DATABASE_URL=postgresql+psycopg://marriage_ocr:marriage_ocr@postgres:5432/marriage_ocr
STORAGE_ROOT=/app/storage
MAX_UPLOAD_BYTES=104857600
UPLOAD_CHUNK_BYTES=1048576
OCR_PYTHON_EXECUTABLE=/usr/local/bin/python
OCR_MODULE=marriage_ocr.cli
OCR_CONFIG_PATH_HANDWRITTEN=/opt/marriage-ocr/config/production.yaml
OCR_CONFIG_PATH_TYPED=/opt/marriage-ocr/config/typed_borang4b.yaml
OCR_TIMEOUT_SECONDS=3600
OCR_MAX_CONCURRENT_JOBS=1
OCR_STDERR_API_LIMIT=1000
MARRIAGE_OCR_GIT_URL=https://github.com/kimcys/marriage-ocr.git
MARRIAGE_OCR_GIT_REF=ad8235c5186c100dea723f7d6a011150dfd18dad
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-vision.json
GEMINI_API_KEY=
# STORAGE_BACKEND=local (default) keeps everything on local disk. Set to "s3" to
# use an S3-compatible bucket (MinIO locally via `docker compose --profile s3 up`,
# or DigitalOcean Spaces in production) for exports and uploaded source documents.
STORAGE_BACKEND=local
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_BUCKET_NAME=exports
MINIO_REGION_NAME=us-east-1
MINIO_ACCESS_KEY_ID=minio
MINIO_SECRET_ACCESS_KEY=minio123
# JOB_EXECUTOR_BACKEND=thread_pool (default here, and what tests use) runs OCR
# jobs in a single in-process thread. docker-compose sets it to "celery" so
# `docker compose up` dispatches jobs to the scalable `worker` service(s) over
# Valkey instead -- see jobs/celery_executor.py / jobs/tasks.py.
JOB_EXECUTOR_BACKEND=thread_pool
VALKEY_URL=redis://valkey:6379/0